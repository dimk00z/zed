// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "inlay_hints": {
    "enabled": true,
  },
  "close_on_file_delete": true,
  "vim_mode": true,
  "file_scan_exclusions": [
    "**/.ruff_cache",
    "**/__pycache__",
    "**/.pytest_cache",
    // default values below
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "title_bar": {
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_icon": true,
  },
  "debugger": {
    "button": true,
  },
  "search": {
    "button": true,
  },
  "diagnostics": {
    "button": false,
  },
  "status_bar": {
    "active_language_button": true,
  },
  "disable_ai": true,
  "completion_menu_scrollbar": "auto",
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": true,
    },
  },
  "icon_theme": "VSCode Icons for Zed (Dark)",
  "collaboration_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "terminal": {
    "font_size": 14.0,
    "font_family": "JetBrainsMono Nerd Font",
  },
  "base_keymap": "VSCode",
  "agent": {
    "dock": "right",
    "enabled": true,
    "button": true,
    "favorite_models": [],
    "model_parameters": [],
  },
  "preview_tabs": {
    "enabled": true,
  },
  "tab_bar": {
    "show": false,
  },
  "tabs": {
    "file_icons": true,
    "show_close_button": "always",
  },
  "sticky_scroll": {
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "wrap_guides": [80],
  "preferred_line_length": 80,
  "soft_wrap": "editor_width",
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true,
      },
      "format_on_save": "on",
      "language_servers": ["ty", "ruff"],
      "formatter": [{ "code_action": "source.fixAll.ruff" }],
    },
  },
  "lsp": {
    "terraform-ls": {
      "settings": {
        "path": "/opt/homebrew/bin/terraform-ls",
      },
    },
    "ty": {
      "binary": {
        "path": "/Users/ds/.local/bin/ty",
        "arguments": ["server"],
      },
      "settings": {
        "diagnosticMode": "workspace",
        "inlayHints": {
          "variableTypes": true,
          "callArgumentNames": true,
        },
      },
    },
  },
}
