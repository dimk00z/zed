// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "colorize_brackets": true,
  "edit_predictions": {
    "provider": "codestral",
    "open_ai_compatible_api": {
      "prompt_format": "code_gemma",
      "model": "",
      "api_url": "http://localhost:1234/v1",
    },
    "ollama": {
      "model": "gemma4:e4b",
      "api_url": "http://localhost:11434",
    },
    "mode": "subtle",
  },
  "cli_default_open_behavior": "new_window",
  "autosave": "on_window_change",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "default",
        "mode": "auto",
        "effort": "default",
      },
      "type": "registry",
    },
  },
  "inlay_hints": {
    "enabled": true,
  },
  "close_on_file_delete": true,
  "vim_mode": true,
  "file_scan_exclusions": [
    "**/.ruff_cache",
    "**/__pycache__",
    "**/.pytest_cache",
    // default values below
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "title_bar": {
    "show_branch_status_icon": true,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
  },
  "debugger": {
    "button": true,
  },
  "search": {
    "button": true,
  },
  "diagnostics": {
    "button": false,
  },
  "status_bar": {
    "active_language_button": true,
  },
  "disable_ai": false,
  "completion_menu_scrollbar": "auto",
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": true,
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "VSCode Icons for Zed (Dark)",
    "dark": "VSCode Icons for Zed (Dark)",
  },
  "collaboration_panel": {
    "dock": null,
    "button": false,
  },
  "outline_panel": {
    "dock": "right",
    "button": false,
  },
  "git_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "terminal": {
    "font_size": 14.0,
    "font_family": "JetBrainsMono Nerd Font",
  },
  "base_keymap": "VSCode",
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "lmstudio",
      "model": "google/gemma-4-e4b",
      "enable_thinking": false,
    },
    "sidebar_side": "right",
    "dock": "right",
    "enabled": true,
    "button": true,
    "favorite_models": [],
    "model_parameters": [],
  },
  "preview_tabs": {
    "enabled": true,
  },
  "tab_bar": {
    "show": false,
  },
  "tabs": {
    "file_icons": true,
    "show_close_button": "always",
  },
  "sticky_scroll": {
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "wrap_guides": [80],
  "preferred_line_length": 80,
  "soft_wrap": "editor_width",
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "JetBrains Islands Light",
    "dark": "Pustota",
  },
  "languages": {
    "SQL": {
      "formatter": {
        "external": {
          "command": "sql-formatter",
          "arguments": ["--language", "postgresql"],
        },
      },
      "format_on_save": "on",
    },
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true,
      },
      "format_on_save": "on",
      "language_servers": ["!basedpyright", "!pyrefly", "ty", "ruff"],
      "formatter": ["language_server"],
    },
  },
  "lsp": {
    "basedpyright": {
      "binary": {
        "path": "/Users/ds/.local/bin/basedpyright-langserver",
        "arguments": ["--stdio"],
      },
    },
    "terraform-ls": {
      "settings": {
        "path": "/opt/homebrew/bin/terraform-ls",
      },
    },
    "ty": {
      "binary": {
        "path": "/Users/ds/.local/bin/ty",
        "arguments": ["server"],
      },
      "settings": {
        "diagnosticMode": "workspace",
        "inlayHints": {
          "variableTypes": true,
          "callArgumentNames": true,
        },
      },
    },
  },
  "double_click_in_multibuffer": "open",
  // some
}
